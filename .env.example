# Dummy-only template. Never commit a populated .env or real credentials.
# pnpm dev has matching defaults and inherits exported overrides. Docker Compose
# reads an uncommitted root .env for ${...} substitutions.

# Local development entrypoints. Keep PORT/WEB_PORT and the browser-visible auth
# origin coupled when changing ports. DEV_API_ORIGIN applies when starting the web
# workspace directly; root pnpm dev derives it from PORT.
PORT=4000
WEB_PORT=3000
DEV_API_ORIGIN=http://127.0.0.1:4000
DATABASE_URL=postgresql://mapchat_test:mapchat_test@127.0.0.1:55431/mapchat_foundation_test
REDIS_URL=redis://127.0.0.1:56381
READINESS_TIMEOUT_MS=1000

# Required by the API. These values are intentionally unusable for real OAuth.
BETTER_AUTH_SECRET=local-only-dummy-auth-secret-change-before-deployment-2026
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000
GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret

# Optional validated API/write-limiter overrides for direct API or pnpm dev use;
# shown values equal production defaults. compose.yaml currently supplies its own
# fixed API/database/Redis/readiness values and does not interpolate these fields.
RATE_LIMIT_KEY_PREFIX=mapchat:write
ROOM_RATE_LIMIT_MAX=5
ROOM_RATE_LIMIT_WINDOW_SECONDS=60
MESSAGE_RATE_LIMIT_MAX=30
MESSAGE_RATE_LIMIT_WINDOW_SECONDS=60

# Optional test-service discovery overrides; root scripts already default to these.
TEST_POSTGRES_HOST=127.0.0.1
TEST_POSTGRES_PORT=55431
TEST_REDIS_HOST=127.0.0.1
TEST_REDIS_PORT=56381
TEST_DATABASE_URL=postgresql://mapchat_test:mapchat_test@127.0.0.1:55431/mapchat_foundation_test
TEST_REDIS_URL=redis://127.0.0.1:56381
TEST_REDIS_KEY_PREFIX=foundation:task001:local:

# Optional Playwright origin/report overrides. The production proxy must already
# be owned by the run; the realtime proxy and its resources are runner-owned.
PLAYWRIGHT_PRODUCTION_BASE_URL=http://127.0.0.1:8081
PLAYWRIGHT_REALTIME_BASE_URL=http://127.0.0.1:18081
PLAYWRIGHT_HTML_OUTPUT_DIR=playwright-report
ROOM_REALTIME_FIXTURE_PORT=4108
ROOM_REALTIME_WEB_PORT=3108
ROOM_REALTIME_PROXY_PORT=18081
ROOM_REALTIME_FIXTURE_CONTAINER=wolfpack-e2e-realtime-fixture
ROOM_REALTIME_WEB_CONTAINER=wolfpack-e2e-realtime-web
ROOM_REALTIME_PROXY_CONTAINER=wolfpack-e2e-realtime-proxy
ROOM_REALTIME_NETWORK=wolfpack-e2e-realtime
# Diagnostic only: setting this to 1 deliberately makes the realtime child fail.
E2E_RUNNER_FORCE_REALTIME_CHILD_FAILURE=0

# No NEXT_PUBLIC_* map credential is required or supported. Stadia domain
# authentication and licensing are external operational configuration.
